# Database Configuration
# For development with PostgreSQL:
DATABASE_URL=postgresql://postgres:password@localhost:5432/governance_portal

# For development with SQLite (fallback):
# DATABASE_URL=sqlite:///./governance_portal.db

# Security
SECRET_KEY=your-secret-key-change-in-production-use-at-least-32-characters
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CORS Configuration
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Application
APP_NAME=Enterprise DaaS Governance Portal
APP_VERSION=2.0.0
DEBUG=True

# Email Configuration (for future use)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@company.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_EMAIL=noreply@company.com
SMTP_FROM_NAME=DaaS Governance Portal

# Notification Configuration
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL
ENABLE_EMAIL_NOTIFICATIONS=False
ENABLE_SLACK_NOTIFICATIONS=False
