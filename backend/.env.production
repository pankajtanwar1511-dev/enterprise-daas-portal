# Production Environment Configuration
# Enterprise DaaS Governance Portal
# ⚠️  CHANGE ALL PASSWORDS AND SECRETS BEFORE DEPLOYMENT!

# Database Configuration
# Use managed database service (AWS RDS, Azure Database, etc.)
DATABASE_URL=postgresql://daas_admin:CHANGE_THIS_PASSWORD@your-db-host.rds.amazonaws.com:5432/governance_portal

# Security - GENERATE NEW SECRETS!
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=CHANGE_THIS_TO_RANDOM_32_CHAR_STRING_USE_SECRETS_TOKEN_URLSAFE
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# CORS Configuration (restrict to your domain only)
ALLOWED_ORIGINS=https://yourdomain.com,https://api.yourdomain.com

# Application
APP_NAME=Enterprise DaaS Governance Portal
APP_VERSION=2.0.0
DEBUG=False
LOG_LEVEL=INFO

# Email Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@company.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_EMAIL=noreply@yourdomain.com
SMTP_FROM_NAME=DaaS Governance Portal
ENABLE_EMAIL_NOTIFICATIONS=True

# Slack Notifications
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL
ENABLE_SLACK_NOTIFICATIONS=True

# Rate Limiting (enabled in production)
RATE_LIMIT_ENABLED=True
RATE_LIMIT_PER_MINUTE=20

# Logging Configuration
LOG_LEVEL=INFO
ENVIRONMENT=production
SLOW_REQUEST_THRESHOLD_MS=500

# Sentry (Error Tracking) - CONFIGURE IN PRODUCTION
ENABLE_SENTRY=True
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id
# Get your Sentry DSN from: https://sentry.io/settings/your-org/projects/your-project/keys/

# Feature Flags
ENABLE_WEBHOOKS=True
ENABLE_API_KEYS=True
ENABLE_BULK_IMPORT=True

# Cache (Redis)
REDIS_URL=redis://localhost:6379/0
ENABLE_REDIS_CACHE=False
